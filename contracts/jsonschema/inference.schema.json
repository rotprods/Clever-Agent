{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rotprods.dev/clever/v1/inference.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "requestId", "attemptId", "principal", "sessionId", "engineId", "modelId", "inputs", "config", "deadlineAt", "idempotencyKey"],
  "properties": {
    "contractVersion": {"$ref": "https://schemas.rotprods.dev/clever/v1/common.schema.json#/$defs/contractVersion"},
    "requestId": {"type": "string", "minLength": 1},
    "attemptId": {"type": "string", "minLength": 1},
    "principal": {"$ref": "https://schemas.rotprods.dev/clever/v1/common.schema.json#/$defs/principalRef"},
    "sessionId": {"type": "string", "minLength": 1},
    "engineId": {"type": "string", "minLength": 1},
    "modelId": {"type": "string", "minLength": 1},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["INFERENCE_ROLE_SYSTEM", "INFERENCE_ROLE_USER", "INFERENCE_ROLE_ASSISTANT", "INFERENCE_ROLE_TOOL"]},
          "content": {"type": "string"},
          "name": {"type": "string"}
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxOutputTokens", "stream"],
      "properties": {
        "maxOutputTokens": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "temperature": {"type": "number", "minimum": 0},
        "topP": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "stopSequences": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "stream": {"type": "boolean"}
      }
    },
    "deadlineAt": {"$ref": "https://schemas.rotprods.dev/clever/v1/common.schema.json#/$defs/timestamp"},
    "idempotencyKey": {"type": "string", "minLength": 1}
  }
}
