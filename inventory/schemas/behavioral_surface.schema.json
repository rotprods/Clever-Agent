{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rotprods.dev/schemas/behavioral_surface.schema.json",
  "title": "Clever-Agent Behavioral Surface",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "surface_id", "source_repo", "source_commit", "family",
    "surface_kind", "name", "runtime_owner", "source_path", "line",
    "interface", "evidence_strength", "promotion_status", "provenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "surface_id": {"type": "string", "minLength": 12},
    "source_repo": {"enum": ["openjarvis", "openclaw", "omi", "clicky"]},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "family": {"type": "string", "minLength": 1},
    "surface_kind": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "runtime_owner": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "line": {"type": "integer", "minimum": 1},
    "interface": {"type": "object"},
    "registration_evidence": {"type": "array", "items": {"type": "string"}},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "state_effects": {"type": "array", "items": {"type": "string"}},
    "lifecycle": {"type": "array", "items": {"type": "string"}},
    "failure_semantics": {"type": "array", "items": {"type": "string"}},
    "platform_constraints": {"type": "array", "items": {"type": "string"}},
    "evidence_strength": {"enum": ["DEFINITION", "REGISTRATION", "ROUTE_OR_PROTOCOL", "BEHAVIOR_TEST"]},
    "promotion_status": {"enum": ["DISCOVERED_CANDIDATE", "BEHAVIOR_MAPPED"]},
    "provenance": {
      "type": "object",
      "required": ["extractor", "source_sha256"],
      "properties": {
        "extractor": {"type": "string"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "matched_text": {"type": "string"}
      }
    }
  }
}
